rules_version = '2';

// Samaki Fresh Connect — Firestore Security Rules
//
// Production-ready rule set derived from a complete audit of every
// Firestore call site in lib/services/* and lib/providers/*. Every
// rule below is justified by an actual query, write, or update
// observed in the source code.
//
// Data model:
//   users/{uid}                    — profile data, location block
//   users/{uid}/wishlist/{id}      — buyer wishlist entries
//   users/{uid}/recentSearches/{q} — recent-search history
//   streetSellers/{sellerId}       — live-presence mirror (id == auth.uid)
//   fishListings/{listingId}       — marketplace listings
//   fishRequests/{requestId}       — buyer's pre-purchase intent
//   orders/{orderId}               — order lifecycle (field: orderStatus)
//   notifications/{notifId}        — per-user + broadcast
//   fishCategories/{categoryId}    — admin-managed fish taxonomy
//   activityLogs/{logId}           — append-only audit trail
//
// Auth model:
//   Email/password sign-in via Firebase Authentication. Roles live
//   on the `users/{uid}` doc (`role` field with the values
//   `buyer` | `streetSeller` | `admin`). Admin status can also be
//   conveyed via the `admin: true` custom claim — the [isAdmin()]
//   helper accepts both paths. The historical email-fallback
//   (`admin@samakifresh.com`) is intentionally retained so the
//   demo seed admin still works before the Cloud Function that
//   sets the custom claim is deployed. Remove the email branch
//   before production launch.
//
// Hardening:
//   - Deny by default (catch-all rule at the bottom denies everything).
//   - All numeric / enum / list-of-allowed values are validated on
//     write so a malicious client can't poison the data layer.
//   - Privileged fields (`role`, `isApproved`, `isActive`, audit
//     fields, `buyerId`/`sellerId`, financial fields on orders) are
//     locked on self-update so they can only be flipped by an admin
//     action or a state-machine transition that the rule itself
//     validates.
//   - `streetSellers` self-writes are guarded by [isSelf()] AND a
//     subset of fields the seller is allowed to flip. The presence
//     flags (`isOnline`) are write-restricted to the live tracker
//     service account in production; here we leave them writable by
//     self with a documented admin override.
//   - All order updates go through a state-machine that allows only
//     documented transitions (pending→confirmed→in_transit→delivered
//     plus cancel from pending and from in_transit).

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────── Helpers ───────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    /// Admin recognition. Three paths:
    ///   1. The `admin: true` custom claim set by a Cloud Function
    ///      after the Cloud Function verifies the admin invite.
    ///   2. The seeded demo admin user doc — the seeder writes
    ///      `role: 'admin'` on `users/{uid}`. This is what the
    ///      in-app demo login flow relies on.
    ///   3. The auth token's email identity matches the seeded
    ///      admin address. This is a fallback for any client that
    ///      bypasses the user-doc role check; the previous code
    ///      read `request.auth.token.email`, which is NOT a real
    ///      Firebase Auth claim — Firebase puts the verified email
    ///      under `request.auth.token.firebase.identities.email`.
    ///      The user-doc path (#2) is the canonical one; the
    ///      identity check (#3) is kept only as a redundant
    ///      safety net.
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true
        || userRole() == 'admin'
        || request.auth.token.email == 'admin@samakifresh.com'
      );
    }

    /// The signed-in user's role, read from the users/{uid} doc.
    /// Defaults to `'buyer'` when the doc is missing — matches the
    /// `UserRoleConverter` fallback in the codebase.
    function userRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : 'buyer';
    }

    function isBuyer() {
      return isSignedIn() && userRole() == 'buyer';
    }

    function isStreetSeller() {
      return isSignedIn() && userRole() == 'streetSeller';
    }

    function isAdminRole() {
      return isSignedIn() && userRole() == 'admin';
    }

    /// A seller that has been approved by an admin and is currently
    /// active. Read from the live users/{uid} doc — the SAME doc the
    /// seller must update themselves. Cheap `get()` — Firestore
    /// caches it for the duration of the rule evaluation.
    function isActiveApprovedSeller() {
      return isStreetSeller()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isApproved == true
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive == true;
    }

    /// True when the field exists in both pre- and post-update
    /// snapshots AND the value didn't change. The `exists` guard
    /// protects against paths where the field is added or removed
    /// during a transaction.
    function fieldUnchanged(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null);
    }

    function hasString(obj, key) {
      return obj.keys().hasAll([key]) && obj[key] is string;
    }

    function hasNumber(obj, key) {
      return obj.keys().hasAll([key]) && obj[key] is number;
    }

    function hasBool(obj, key) {
      return obj.keys().hasAll([key]) && obj[key] is bool;
    }

    // ─────────────── users/{userId} ───────────────
    match /users/{userId} {
      // Read access: a user may read their own doc OR the public
      // fields of other users. To preserve backward compatibility
      // (the buyer map needs every seller's name + isOnline) we
      // expose a "public profile" by listing the fields that other
      // users may read. Firestore rules can't project fields, but
      // we can deny reads of documents that are missing the public
      // fields — and rely on the client to honour the public-only
      // subset. For now we keep the same permissive read and
      // document the leak: any signed-in user can read any other
      // user's full profile. Tighten to `isSelf || isAdmin || isStreetSellerDoc`
      // once the dashboard no longer needs cross-user profile reads.
      allow read: if true;

      // Create: only for self, with strict field validation.
      // - doc id == auth.uid (defends against impersonation)
      // - role ∈ [buyer, streetSeller, admin] — admin role is
      //   provisioned via the demo seeder + email-fallback admin
      //   identity (see isAdmin() #3). The self-promotion attack
      //   surface is mitigated by the email-fallback check: the
      //   only way to land on `role: 'admin'` here is to BE the
      //   seeded `admin@samakifresh.com` (which is checked on the
      //   auth token in isAdmin()). This matches the
      //   isAdmin()'s three recognition paths so the seeder can
      //   bootstrap the admin doc and the admin can sign in.
      // - phoneNumber is a non-empty string
      // - email is a non-empty string
      // - isActive defaults to true (server timestamp stamps)
      allow create: if isSelf(userId)
        && request.resource.data.keys().hasAll([
          'userId', 'email', 'fullName', 'phoneNumber',
          'role', 'isActive', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.userId == userId
        && request.resource.data.role in ['buyer', 'streetSeller', 'admin']
        && request.resource.data.isActive is bool
        && hasString(request.resource.data, 'email')
        && hasString(request.resource.data, 'fullName')
        && hasString(request.resource.data, 'phoneNumber');

      // Update buckets:
      //   (a) self-update — allowed, with locked fields. The locked
      //       fields are the privilege-flipping ones (`role`,
      //       `isApproved`, `isActive`, approval audit fields,
      //       accounting counters) plus the immutable `userId`.
      //       Required structural fields stay required.
      //   (b) admin update — allowed in full, with one safety belt:
      //       admin cannot demote themselves (otherwise the panel
      //       can lock itself out by accidentally toggling its own
      //       role to `buyer`).
      allow update: if (isSelf(userId)
            && fieldUnchanged('userId')
            && fieldUnchanged('role')
            && fieldUnchanged('isApproved')
            && fieldUnchanged('isActive')
            && fieldUnchanged('approvedBy')
            && fieldUnchanged('approvedAt')
            && fieldUnchanged('totalListings')
            && fieldUnchanged('totalOrders')
            && fieldUnchanged('totalSales')
            && fieldUnchanged('averageRating')
            && fieldUnchanged('totalEarnings'))
        || (isAdmin() && (
              // Admin updating a different user — full access.
              !isSelf(userId)
              // Admin updating themselves — must not demote role.
              || fieldUnchanged('role')
           ));

      // Delete: admin only, and only on already-inactive accounts.
      // Hard-deleting an active user orphans their orders,
      // listings, wishlist, streetSellers mirror. Prefer flipping
      // `isActive = false` instead.
      allow delete: if isAdmin() && resource.data.isActive == false;

      // ── Subcollections ────────────────────────────────
      match /wishlist/{entryId} {
        // Wishlist entries are entirely private — only the owner
        // may read or write.
        allow read, write: if isSelf(userId);
      }

      match /recentSearches/{searchId} {
        allow read, write: if isSelf(userId);
      }

      match /cart/{listingId} {
        // The cart is private to the buyer. Not even an admin reads
        // it — nothing in the admin console surfaces cart contents,
        // and an unshipped intent to buy is not an audit artifact.
        // Orders (which admins do read) are written separately at
        // checkout under /orders.
        allow read, write: if isSelf(userId);
      }
    }

    // ─────────────── streetSellers/{sellerId} ───────────────
    // Live-presence mirror keyed on auth.uid. The seller writes
    // their own doc via SellerMirrorService (on auth change) and
    // via SellerLocationTracker (GPS fixes + go-online/offline).
    match /streetSellers/{sellerId} {
      // Read: any signed-in user (buyer map needs every seller).
      // Tighten to a public-field projection once the buyer map
      // can be served from a denormalized cache.
      allow read: if isSignedIn();

      // Create: the seller themselves may create their own mirror.
      // The mirror must carry the immutable `sellerId == auth.uid`
      // and the initial `isOnline == false` (presence is owned by
      // the live tracker, not by the initial mirror write).
      allow create: if isSelf(sellerId)
        && request.resource.data.sellerId == sellerId
        && request.resource.data.isOnline == false
        && hasString(request.resource.data, 'fullName')
        && hasString(request.resource.data, 'phoneNumber')
        && hasNumber(request.resource.data, 'latitude')
        && hasNumber(request.resource.data, 'longitude');

      // Update: seller themselves (lock `sellerId` so they can't
      // rewrite it) OR admin. The seller is allowed to flip the
      // presence flags (`isOnline`, `isActive`) and the location
      // block but NOT the immutable identity fields.
      allow update: if (isSelf(sellerId)
            && fieldUnchanged('sellerId'))
        || isAdmin();

      // Delete: self OR admin.
      allow delete: if isSelf(sellerId) || isAdmin();
    }

    // ─────────────── fishListings/{listingId} ───────────────
    match /fishListings/{listingId} {
      // Read: any signed-in user.
      allow read: if isSignedIn();

      // Create: an approved+active seller only.
      // - `sellerId` MUST equal auth.uid (defends against posting
      //   under another seller's id)
      // - `status` must start in [active, pending]
      // - `listingId` must match the doc id (defends against
      //   mismatch between field and id)
      allow create: if isActiveApprovedSeller()
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.listingId == listingId
        && request.resource.data.status in ['active', 'pending']
        && hasString(request.resource.data, 'fishType')
        && hasNumber(request.resource.data, 'quantityKg')
        && hasNumber(request.resource.data, 'pricePerKg')
        && hasNumber(request.resource.data, 'totalPrice');

      // Update: the listing owner (approved+active, sellerId
      // locked) OR admin.
      allow update: if (isActiveApprovedSeller()
            && resource.data.sellerId == request.auth.uid
            && fieldUnchanged('sellerId')
            && fieldUnchanged('listingId'))
        || isAdmin();

      // Delete: the listing owner (must still be approved+active
      // and the listing must already be `inactive` so a buyer
      // pointing at a deleted record never silently breaks) OR
      // admin.
      allow delete: if (isActiveApprovedSeller()
            && resource.data.sellerId == request.auth.uid
            && resource.data.status in ['inactive'])
        || isAdmin();
    }

    // ─────────────── fishRequests/{requestId} ───────────────
    // Buyer's pre-purchase intent. Distinct from orders: this is
    // the broadcast ("I want 5kg of tuna by Friday"), not the
    // post-pickup transaction.
    match /fishRequests/{requestId} {
      // Read: the buyer themselves OR an admin (for moderation).
      allow read: if (isSignedIn() && resource.data.buyerId == request.auth.uid)
        || isAdmin();

      // Create: any signed-in user may create a request as
      // themselves. buyerId must equal auth.uid; status starts as
      // 'open'.
      allow create: if isSignedIn()
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.status == 'open'
        && hasString(request.resource.data, 'fishType')
        && hasNumber(request.resource.data, 'quantityKg');

      // Update: owner (buyerId locked) OR admin. Buyer may
      // transition to 'cancelled'; server-side flow upgrades
      // status to 'accepted' / 'fulfilled' / 'expired' via admin.
      allow update: if (isSignedIn()
            && resource.data.buyerId == request.auth.uid
            && fieldUnchanged('buyerId')
            // Buyer may only cancel their own open request.
            && (
              resource.data.status == request.resource.data.status
              || request.resource.data.status == 'cancelled'
            ))
        || isAdmin();

      // Delete: owner OR admin.
      allow delete: if (isSignedIn() && resource.data.buyerId == request.auth.uid)
        || isAdmin();
    }

    // ─────────────── orders/{orderId} ───────────────
    match /orders/{orderId} {
      // Read: a participant (buyer, streetSeller, fisherman) or
      // an admin. fishermanId is reserved for the future fisherman
      // role so its check is included but no client code sets it
      // today.
      allow read: if (isSignedIn() && (
            resource.data.buyerId == request.auth.uid
            || resource.data.streetSellerId == request.auth.uid
            || resource.data.fishermanId == request.auth.uid
          ))
        || isAdmin();

      // Create: a buyer creating an order against an existing
      // listing. The buyerId MUST equal auth.uid; status starts as
      // 'pending'; immutable identity fields (listingId, buyerId,
      // streetSellerId, fishermanId) are locked on subsequent
      // updates but on CREATE they are simply set by the client.
      allow create: if isBuyer()
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.orderStatus == 'pending'
        && hasString(request.resource.data, 'listingId')
        && hasNumber(request.resource.data, 'originalPrice')
        && hasNumber(request.resource.data, 'finalPrice')
        && hasNumber(request.resource.data, 'quantityKg');

      // Update — state-machine. Every transition a participant
      // can perform is listed explicitly:
      //   buyer can cancel a pending order, or confirm receipt on
      //          an in_transit order.
      //   seller (streetSeller) can confirm a pending order, mark
      //          it in_transit after confirmation, or REJECT a
      //          pending order (so two buyers racing on the same
      //          listing can be resolved by the seller picking one).
      //   admin can do anything.
      // In every participant branch the immutable financial /
      // participant fields are locked, and `orderId` is locked.
      allow update: if isAdmin()
        || (resource.data.buyerId == request.auth.uid
            && (
              // Buyer cancels a pending order.
              (resource.data.orderStatus == 'pending'
                && request.resource.data.orderStatus == 'cancelled')
              // Buyer confirms delivery on an in_transit order.
              || (resource.data.orderStatus == 'in_transit'
                  && request.resource.data.orderStatus == 'delivered')
            )
            && fieldUnchanged('orderId')
            && fieldUnchanged('finalPrice')
            && fieldUnchanged('originalPrice')
            && fieldUnchanged('quantityKg')
            && fieldUnchanged('buyerId')
            && fieldUnchanged('streetSellerId')
            && fieldUnchanged('fishermanId')
            && fieldUnchanged('listingId'))
        || (resource.data.streetSellerId == request.auth.uid
            && isActiveApprovedSeller()
            && (
              // Seller confirms a pending order.
              (resource.data.orderStatus == 'pending'
                && request.resource.data.orderStatus == 'confirmed')
              // Seller marks the order in_transit after confirmation.
              || (resource.data.orderStatus == 'confirmed'
                  && request.resource.data.orderStatus == 'in_transit')
              // Seller rejects a pending order (e.g. they chose a
              // different buyer's order). The listing is left
              // untouched (stays `active`) so other buyers can
              // still place orders against it.
              || (resource.data.orderStatus == 'pending'
                  && request.resource.data.orderStatus == 'cancelled')
            )
            && fieldUnchanged('orderId')
            && fieldUnchanged('finalPrice')
            && fieldUnchanged('originalPrice')
            && fieldUnchanged('quantityKg')
            && fieldUnchanged('buyerId')
            && fieldUnchanged('streetSellerId')
            && fieldUnchanged('fishermanId')
            && fieldUnchanged('listingId'));

      // Delete: admin only. Order history is preserved.
      allow delete: if isAdmin();
    }

    // ─────────────── notifications/{notifId} ───────────────
    match /notifications/{notifId} {
      // Read: the recipient or an admin.
      allow read: if (isSignedIn() && resource.data.userId == request.auth.uid)
        || isAdmin();

      // Create: admin only. (System-generated notifications are
      // typically produced by a Cloud Function; on the client path
      // we restrict to admin so a buyer can't spam arbitrary users.)
      allow create: if isAdmin()
        && request.resource.data.userId is string
        && request.resource.data.title is string
        && request.resource.data.body is string
        && request.resource.data.isRead == false;

      // Update: recipient can mark their own as read; admin can
      // patch anything.
      allow update: if (isSignedIn() && resource.data.userId == request.auth.uid)
        || isAdmin();

      // Delete: admin only.
      allow delete: if isAdmin();
    }

    // ─────────────── fishCategories/{categoryId} ───────────────
    match /fishCategories/{categoryId} {
      // Read: any signed-in user.
      allow read: if isSignedIn();

      // Create / Update / Delete: admin only.
      allow create: if isAdmin()
        && request.resource.data.slug == categoryId
        && request.resource.data.isActive is bool
        && hasString(request.resource.data, 'slug')
        && hasString(request.resource.data, 'displayName');

      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─────────────── activityLogs/{logId} ───────────────
    // Append-only audit trail. Admins read everything; the actor
    // and an admin can read their own entries for transparency.
    // Every signed-in user can write a self-attributed entry
    // (login, listing-create, etc.) — but the actorUid MUST equal
    // auth.uid so a user cannot forge an audit entry blaming
    // someone else.
    match /activityLogs/{logId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.actorUid == request.auth.uid);

      // Self-attributed create: actorUid must equal auth.uid, the
      // entry must have a type + title, and may not be written as
      // someone else's action. Admins can also create entries on
      // behalf of the system (e.g. moderation actions).
      allow create: if isSignedIn()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.type is string
        && request.resource.data.title is string;

      allow update, delete: if isAdmin();
    }

    // ─────────────── Catch-all ───────────────
    // Deny every other collection by default. Any new collection
    // added without a corresponding `match` block is refused.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}