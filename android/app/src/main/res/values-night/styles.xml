<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme applied while the Android process is starting (dark mode).
         Same deep navy as the light-mode theme for a consistent launch. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Theme applied as soon as Flutter is running. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/launch_background_color</item>
        <item name="android:windowFullscreen">false</item>
    </style>
</resources>
