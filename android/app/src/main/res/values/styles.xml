<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme applied while the Android process is starting (light mode).
         Uses a dark background so there is NO white flash before Flutter
         draws its first frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Theme applied as soon as Flutter is running.
         Transparent so Flutter draws edge-to-edge. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/launch_background_color</item>
        <item name="android:windowFullscreen">false</item>
    </style>
</resources>
