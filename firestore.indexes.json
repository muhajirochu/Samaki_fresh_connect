{
  "_comment": [
    "Production-ready composite indexes for Samaki Fresh Connect.",
    "Every entry below was derived from a Firestore query observed",
    "in lib/services/* and lib/providers/*. Single-field indexes are",
    "auto-created by Firestore and are NOT enumerated here.",
    "",
    "Validation rule for every entry: a query of the form",
    "  .where(A).where(B).where(C).snapshots()",
    "needs an index whose fields are exactly [A, B, C] (or a prefix",
    "thereof) in the order the filters appear in the query.",
    "",
    "Sort order: descending for createdAt is intentional — the UI",
    "always shows newest first, and Firestore requires a DESCENDING",
    "index when sorting DESCENDING on a range-filtered field."
  ],
  "indexes": [
    {
      "comment": "streamActiveListings: fishListings WHERE status==active. Single-field index 'status' is auto; no composite needed since no .orderBy follows.",
      "collectionGroup": "fishListings",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status",     "order": "ASCENDING" },
        { "fieldPath": "createdAt",  "order": "DESCENDING" }
      ]
    },
    {
      "comment": "streamListingsBySeller: fishListings WHERE sellerId==X. Composite in case future callers add .orderBy(createdAt).",
      "collectionGroup": "fishListings",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "sellerId",   "order": "ASCENDING" },
        { "fieldPath": "createdAt",  "order": "DESCENDING" }
      ]
    },
    {
      "comment": "streamListingsByCategorySlug: fishListings WHERE fishType==X. Composite for future .orderBy.",
      "collectionGroup": "fishListings",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "fishType",   "order": "ASCENDING" },
        { "fieldPath": "createdAt",  "order": "DESCENDING" }
      ]
    },
    {
      "comment": "streamApprovedFish (buyer dashboard): same as streamActiveListings.",
      "collectionGroup": "fishListings",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status",             "order": "ASCENDING" },
        { "fieldPath": "isBrokerApproved",   "order": "ASCENDING" },
        { "fieldPath": "createdAt",          "order": "DESCENDING" }
      ]
    },
    {
      "comment": "streamOrdersByBuyer: orders WHERE buyerId==X. Composite in case .orderBy(createdAt) is added.",
      "collectionGroup": "orders",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "buyerId",     "order": "ASCENDING" },
        { "fieldPath": "createdAt",   "order": "DESCENDING" }
      ]
    },
    {
      "comment": "streamOrdersByStreetSeller: orders WHERE streetSellerId==X.",
      "collectionGroup": "orders",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "streetSellerId", "order": "ASCENDING" },
        { "fieldPath": "createdAt",      "order": "DESCENDING" }
      ]
    },
    {
      "comment": "streamOrdersByStatus: orders WHERE orderStatus==X. Composite for future .orderBy.",
      "collectionGroup": "orders",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "orderStatus", "order": "ASCENDING" },
        { "fieldPath": "createdAt",   "order": "DESCENDING" }
      ]
    },
    {
      "comment": "streamAllStreetSellers + streamAllBuyers + streamUserCountByRole: users WHERE role==X.",
      "collectionGroup": "users",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "role",       "order": "ASCENDING" },
        { "fieldPath": "createdAt",  "order": "DESCENDING" }
      ]
    },
    {
      "comment": "streamSellersByApproval: users WHERE role==streetSeller AND isApproved==X.",
      "collectionGroup": "users",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "role",        "order": "ASCENDING" },
        { "fieldPath": "isApproved",  "order": "ASCENDING" },
        { "fieldPath": "createdAt",   "order": "DESCENDING" }
      ]
    },
    {
      "comment": "streamForUser: notifications WHERE userId==X. Composite for future .orderBy.",
      "collectionGroup": "notifications",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "userId",    "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "comment": "unreadCount: notifications WHERE userId==X AND isRead==false.",
