    {
      "comment": "nearbySellersGeoQueryProvider: streetSellers WHERE geohash>=start AND geohash<=end AND isActive==true. Range query on geohash needs single-field 'geohash' which is auto; the equality on isActive runs against the live docs.",
      "collectionGroup": "streetSellers",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "geohash",  "order": "ASCENDING" },
        { "fieldPath": "isActive", "order": "ASCENDING" }
      ]
    },
    {
      "comment": "streamAllCategories / streamActiveCategories: fishCategories — the unfiltered read needs no composite, the WHERE isActive==true read is covered by the (isActive ASC, displayName ASC) composite below. displayName-only single-field is auto.",
      "collectionGroup": "fishCategories",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "isActive",     "order": "ASCENDING" },
        { "fieldPath": "displayName",  "order": "ASCENDING" }
      ]
    },
