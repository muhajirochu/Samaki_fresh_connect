      ]
    },
    {
      "comment": "streamActiveSellers: streetSellers WHERE isActive==true. Composite for future .orderBy(lastLocationUpdateAt).",
      "collectionGroup": "streetSellers",
      "queryScope": "COLLECTION",
      "fields": [
