# Source code / config files — force LF line endings regardless of host OS.
# Without this, Windows contributors can re-introduce CRLF and break
# shell scripts, YAML parsers, and CI tooling that expects LF.
*           text=auto eol=lf

# Explicit overrides for formats that actually require CRLF.
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf
