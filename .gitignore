# Miscellaneous
*.class
*.log
*.patch
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# Environment files (keep .env.example tracked, never the real .env)
.env
.env.*
!.env.example

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android signing config — never commit. Keep the keystore + key.properties local
# and back them up somewhere safe (1Password, encrypted disk, etc). Losing them
# means you can never publish updates under the same package name.
**/upload-keystore.jks
**/*.jks
**/key.properties
**/upload-keystore.jks.old

# Firebase platform configs contain project IDs and API keys — keep them local.
/android/app/google-services.json
/ios/Runner/GoogleService-Info.plist
/macos/Runner/GoogleService-Info.plist
/firebase-debug.log
/firebase-debug.*.log
/.firebase/

# Claude Code agent state — contains auth tokens and is regenerated per session.
/.claude/
/.flutter-plugins

# App Distribution — generated PDF card lives outside the build tree so a
# future `git add .` does not sweep it in. The in-app generator
# (lib/services/installation_card_pdf_service.dart) is the single source of
# truth.
SamakiFresh_Connect_App_Download_QR.pdf
